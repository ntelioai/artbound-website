# Files in the repo root that should NOT be served as public static assets.
# Wrangler reads this file when bundling the assets directory.

CLAUDE.md
.claude
.claude/**
**/.claude/**
.git
.git/**
.gitignore
.assetsignore
wrangler.jsonc
.wrangler/**
.dev.vars*

# Node / build tooling — must never be served publicly
package.json
package-lock.json
node_modules
node_modules/**
.github
.github/**

# Local-only working folder
clientOnly
clientOnly/**

# Brand source files — large Pixelmator originals
**/*.pxd
assets/images/source/**

# OS junk
.DS_Store
**/.DS_Store

# Raw session logs — these carry guests' phone numbers, and a WhatsApp message id
# has the recipient's number encoded inside it. Only the redacted record written
# by tools/build-session-record.py into sessions/ may ever be served.
tmp
tmp/**

# Build tooling
tools
tools/**
