package.json
package-lock.json
node_modules
node_modules/**
.github
.github/**

# Local-only working folder
clientOnly
clientOnly/**

# Brand source files — large Pixelmator originals
**/*.pxd
assets/images/source/**

# OS junk
.DS_Store
**/.DS_Store
